// The colours of blacklist_detect/ui_theme.py, by role, and the theme switch.
//
// Theme: in-out accent (蓝色 | 棕色 | 紫色 | 绿色 | 红色; default 蓝色), in-out dark (false = 浅色), out p (the
// palette they pick). Theme.palette(accent, dark) gives any other. Light / Dark: the 蓝色 palettes, kept for settings.slint.
// Tokens / Motion: sizes and timings (kit/tokens.slint).

import { Palette, Palettes } from "kit/palettes.slint";
export { Palette, Palettes }
export { Tokens, Motion } from "kit/tokens.slint";

export global Theme {
    in-out property <string> accent: "蓝色";
    in-out property <bool> dark: false;
    out property <Palette> p: Palettes.get(accent, dark);
    // ui_theme._LIGHT's order: the swatches in 设置 › 主题.
    out property <[string]> accents: ["蓝色", "棕色", "紫色", "绿色", "红色"];

    public pure function palette(accent: string, dark: bool) -> Palette {
        Palettes.get(accent, dark)
    }
}

export global Light {
    out property <Palette> palette: Palettes.blue-light;
}

export global Dark {
    out property <Palette> palette: Palettes.blue-dark;
}
