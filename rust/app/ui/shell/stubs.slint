// stub: ui-list, ui-guests, ui-settings, ui-history, ui-stream. Stand-ins for the pages the other UI packages
// export, with the names they will export them by. The app-wiring package points main.slint's import at theirs.

import { Palette } from "../theme.slint";

component Placeholder inherits Rectangle {
    in property <string> label;
    in property <Palette> p;
    Text { text: label; font-size: 14px; color: p.muted; }
}

// 记录: the checks so far, by day.
export component HistoryPage inherits Placeholder { label: "记录"; }
// 黑名单: the list, its tags and search.
export component ListPage inherits Placeholder { label: "黑名单"; }
// 嘉宾: the guests and their scenes.
export component GuestsPage inherits Placeholder { label: "嘉宾"; }
// 设置: the catalog and its sections.
export component SettingsPage inherits Placeholder { label: "设置"; }
// 直播模式's window for the streaming app (a window of its own, not a page): listed so the names line up.
export component StreamPanel inherits Placeholder { label: "直播画面"; }
