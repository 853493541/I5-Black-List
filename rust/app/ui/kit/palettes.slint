    };

    public pure function get(accent: string, dark: bool) -> Palette {
        if accent == "棕色" { return dark ? self.brown-dark : self.brown-light; }
        if accent == "紫色" { return dark ? self.purple-dark : self.purple-light; }
        if accent == "绿色" { return dark ? self.green-dark : self.green-light; }
        if accent == "红色" { return dark ? self.red-dark : self.red-light; }
        dark ? self.blue-dark : self.blue-light
    }
}
