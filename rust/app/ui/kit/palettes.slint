// Every colour of blacklist_detect/ui_theme.py, by role, for each accent in light and dark: _palette() exactly.
// Written from rust/app/src/kit/golden_theme.json (tools/rust_golden_theme.py); kit::tests checks they still match.
//
// Palette: one field per ui_theme role (snake_case there, kebab-case here), plus red-edge, the outline of a
// red tag in the 设置 mock-up. Palettes.get(accent, dark) gives one; an unknown accent falls back to 蓝色,
// as use_theme does.

export struct Palette {
    bg: color,
    surface: color,
    surface-alt: color,
    border: color,
    text: color,
    muted: color,
    hover: color,
    selected: color,
    accent: color,
    accent-line: color,
    accent-hover: color,
    accent-press: color,
    accent-wash: color,
    on-accent: color,
    red: color,
    red-wash: color,
    red-hover: color,
    green: color,
    green-wash: color,
    green-hover: color,
    blue: color,
    blue-wash: color,
    rose: color,
    rose-wash: color,
    rose-hover: color,
    gray: color,
    gray-wash: color,
    gray-hover: color,
    danger: color,
    danger-hover: color,
    warning: color,
    chip-bg: color,
    chip-text: color,
    chip-off-bg: color,
    chip-off-line: color,
    field-line: color,
    toast-bg: color,
    toast-text: color,
    toast-action: color,
    red-edge: color,
}

