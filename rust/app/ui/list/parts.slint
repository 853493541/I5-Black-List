// Small pieces of the 黑名单 page that ui/kit.slint does not have yet.
// stub: ui-kit (a clickable button, a text box, the gray pill and the extra colours below belong in kit / theme).

import { Palette } from "../theme.slint";

// ui_theme's colours the shared Palette lacks: the gray of an off pill and +N, by theme.
export global ListInk {
    out property <color> pill-off-bg-light: #f7f8fa;
    out property <color> pill-off-line-light: #8b93a1;
    out property <color> gray-light: #626977;
    out property <color> pill-off-bg-dark: #22262d;
    out property <color> pill-off-line-dark: #6e7685;
    out property <color> gray-dark: #8d95a3;
}

// The line icons this page uses, on ui_icons' 24 x 24 grid (Icon in kit.slint has only 设置's).
export component Glyph inherits Rectangle {
    in property <string> name;
    in property <length> size: 16px;
    in property <color> tone;
    in property <length> line: 1.6px;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: tone;
        stroke-width: line;
        fill: transparent;
        commands: name == "search"
            ? "M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 M15.3 15.3 L20 20"
            : name == "add"
            ? "M12 5 L12 19 M5 12 L19 12"
            : name == "more"
            ? "M5.5 11.4 L5.5 12.6 M12 11.4 L12 12.6 M18.5 11.4 L18.5 12.6"
            : name == "users"
            ? "M9 4 A3.6 3.6 0 1 0 9 11.2 A3.6 3.6 0 1 0 9 4 M2.5 20 C2.5 15.6 5.4 13.6 9 13.6 C12.6 13.6 15.5 15.6 15.5 20 M15.5 4.4 A3.2 3.2 0 0 1 15.5 10.8 M17.8 13.9 C20.2 14.6 21.5 16.6 21.5 20"
            : name == "eye"
            ? "M2 12 C4.5 7.5 8 5.5 12 5.5 C16 5.5 19.5 7.5 22 12 C19.5 16.5 16 18.5 12 18.5 C8 18.5 4.5 16.5 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9"
            : name == "eye-off"
            ? "M2 12 C4.5 7.5 8 5.5 12 5.5 C16 5.5 19.5 7.5 22 12 C19.5 16.5 16 18.5 12 18.5 C8 18.5 4.5 16.5 2 12 Z M4 4 L20 20"
            : name == "copy"
            ? "M9 9 L20 9 L20 20 L9 20 Z M15 9 L15 4 L4 4 L4 15 L9 15"
            : name == "reload"
            ? "M19 12 A7 7 0 1 1 16.9 7 M19 4 L19 8 L15 8"
            : name == "delete"
            ? "M4 7 L20 7 M9 7 L9 4 L15 4 L15 7 M6 7 L7 20 L17 20 L18 7"
            : name == "up"
            ? "M7 14 L12 9 L17 14"
            : name == "down"
            ? "M7 10 L12 15 L17 10"
            : "M4 20 L4 16 L15 5 L19 9 L8 20 Z";
    }
}

// A tag as a red pill (ui_widgets._draw_pill), or gray and outlined for +N.
export component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> active: true;
    in property <color> wash;
    in property <Palette> p;
    in property <bool> dark;
    height: 21px;
    width: words.preferred-width + 18px;
    border-radius: self.height / 2;
    background: active ? wash : dark ? ListInk.pill-off-bg-dark : ListInk.pill-off-bg-light;
    border-width: active ? 0px : 1px;
    border-color: dark ? ListInk.pill-off-line-dark : ListInk.pill-off-line-light;
    words := Text {
        text: label;
        font-size: 12px;
        font-weight: 600;
        color: active ? p.red : dark ? ListInk.gray-dark : ListInk.gray-light;
    }
}

// QPushButton: outlined, or #primary filled with the accent.
export component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <Palette> p;
    callback clicked();
    height: 32px;
    width: words.preferred-width + 32px;
    border-radius: 6px;
    border-width: primary ? 0px : 1px;
    border-color: touch.has-hover ? p.accent-line : p.border;
    background: primary ? (touch.has-hover ? p.accent-line : p.accent) : touch.has-hover ? p.hover : p.surface;
    words := Text { text: label; font-size: 14px; color: primary ? #ffffff : p.text; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// IconButton: a line icon on a square that lights up under the pointer.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <Palette> p;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? p.hover : transparent;
    Glyph { name: icon; tone: touch.has-hover ? p.text : p.muted; size: 18px; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A text box (QLineEdit): a border that turns the accent while typing, a gray placeholder, maybe an icon in front.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <Palette> p;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    callback cancelled();
    public function grab() { input.focus(); }
    public function select-all() { input.select-all(); }
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? p.accent-line : p.border;
    background: p.surface;
    if icon != "": Glyph { x: 9px; name: icon; tone: p.muted; size: 16px; }
    if input.text == "": Text {
        x: input.x;
        text: placeholder;
        font-size: 14px;
        color: p.muted;
    }
    input := TextInput {
        x: icon != "" ? 32px : 10px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        color: p.text;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            reject
        }
    }
}

// A menu item (QMenu with ui._mark_menu_item's icon): an icon, the words, red for 删除 / 清空.
export component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> danger;
    in property <Palette> p;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? p.hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 16px;
        spacing: 8px;
        if icon != "": Glyph { y: (parent.height - 16px) / 2; name: icon; tone: danger ? p.danger : p.muted; }
        Text { vertical-alignment: center; text: label; font-size: 14px; color: danger ? p.danger : p.text; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component MenuLine inherits Rectangle {
    in property <Palette> p;
    height: 9px;
    Rectangle { y: 4px; height: 1px; background: p.border; }
}

// The card a menu sits on.
export component MenuCard inherits Rectangle {
    in property <Palette> p;
    background: p.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: p.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #0000002a;
    VerticalLayout {
        padding: 4px;
        @children
    }
}
