// 记录: the lobbies checked (blacklist_detect/ui.py _history_page, _reload_history, _show_history_scan). Left, a
// 168 px column of days, each with the times of its checks under it; right, the card of the chosen check: its title,
// 更多 (删除, 清空记录), and its twelve seats two to a row. With no checks, the empty state alone.
// src/history fills HistoryData and takes its callbacks.

import { Palette, Tokens } from "../theme.slint";
import { LineIcon } from "../kit/icons.slint";
import { IconButton } from "../kit/buttons.slint";
import { EmptyState } from "../kit/frames.slint";

// A line of the left column: a day ("day") or one check's time under it ("time").
export struct HistoryItem {
    kind: string,
    text: string,
    // The day a time belongs to, or the day itself.
    day: string,
    // The check, an index into the records; -1 for a day.
    scan: int,
    // Seats on the 黑名单 in that check: a red mark and the count.
    hits: int,
    // A day: whether its times show.
    open: bool,
}

// One seat: the name as shown and how it reads: hit (黑名单), like (嘉宾), me (我), unclear (未识别) or plain.
export struct HistorySeat {
    name: string,
    tone: string,
}

export global HistoryData {
    in-out property <[HistoryItem]> items;
    in-out property <[HistorySeat]> seats;
    // The check shown on the right.
    in-out property <int> picked: -1;
    in-out property <bool> empty: true;
    callback picked-scan(int);
    callback day-toggled(string);
    callback seat-clicked(int);
    callback delete-record();
    callback clear-records();
}

component DayRow inherits Rectangle {
    in property <HistoryItem> item;
    in property <Palette> p;
    callback clicked;
    height: 30px;
    border-radius: Tokens.radius;
    background: touch.has-hover ? p.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        LineIcon { y: (parent.height - 16px) / 2; name: item.open ? "folder" : "folder"; size: 16px; tone: p.muted; }
        Text { text: item.text; color: p.text; font-size: Tokens.body; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component TimeRow inherits Rectangle {
    in property <HistoryItem> item;
    in property <bool> chosen;
    in property <Palette> p;
    callback clicked;
    height: 30px;
    border-radius: Tokens.radius;
    background: chosen ? p.selected : touch.has-hover ? p.hover : transparent;
    HorizontalLayout {
        padding-left: 32px;
        padding-right: 12px;
        spacing: 3px;
        Text { text: item.text; color: p.text; font-size: Tokens.body; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if item.hits > 0: LineIcon { y: (parent.height - 14px) / 2; name: "warning"; size: 14px; tone: p.red; }
        if item.hits > 0: Text { text: item.hits; color: p.red; font-size: Tokens.small; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SeatTile inherits Rectangle {
    in property <HistorySeat> seat;
    in property <Palette> p;
    callback clicked;
    property <color> tone: seat.tone == "hit" ? p.red : seat.tone == "like" ? p.rose : seat.tone == "me" ? p.green
        : seat.tone == "unclear" ? p.gray : p.text;
    property <color> wash: seat.tone == "hit" ? p.red-wash : seat.tone == "like" ? p.rose-wash
        : seat.tone == "me" ? p.green-wash : transparent;
    property <color> hover: seat.tone == "hit" ? p.red-hover : seat.tone == "like" ? p.rose-hover
        : seat.tone == "plain" ? p.gray-wash : wash;
    Rectangle {
        x: 6px;
        y: 3px;
        width: parent.width - 12px;
        height: parent.height - 6px;
        border-radius: Tokens.radius;
        background: touch.has-hover ? hover : wash;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            if seat.tone == "hit": LineIcon { y: (parent.height - 16px) / 2; name: "warning"; size: 16px; tone: p.red; }
            if seat.tone == "like": LineIcon { y: (parent.height - 16px) / 2; name: "heart"; size: 16px; tone: p.rose; }
            Text {
                text: seat.name;
                color: tone;
                font-size: Tokens.body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
    touch := TouchArea { mouse-cursor: seat.tone == "unclear" ? default : pointer; clicked => { root.clicked(); } }
}

export component HistoryPage inherits Rectangle {
    in property <bool> dark;
    in property <Palette> p;
    property <length> row-h: Tokens.row-h + 4px;
    property <length> head-h: 48px;
    property <bool> menu-open;

    if HistoryData.empty: EmptyState {
        y: 13px;
        height: parent.height - 13px;
        p: p;
        icon: "records";
        title: "还没有记录";
        hint: "进入「推演成功」大厅时自动检查";
    }

    if !HistoryData.empty: Flickable {
        x: 0px;
        y: 13px;
        width: 168px;
        height: parent.height - 13px;
        content-height: column.preferred-height;
        column := VerticalLayout {
            alignment: start;
            spacing: 2px;
            for item in HistoryData.items: Rectangle {
                height: item.kind == "time" && !item.open ? 0px : 30px;
                visible: item.kind == "day" || item.open;
                if item.kind == "day": DayRow {
                    item: item;
                    p: p;
                    clicked => { HistoryData.day-toggled(item.day); }
                }
                if item.kind == "time": TimeRow {
                    item: item;
                    p: p;
                    chosen: item.scan == HistoryData.picked;
                    clicked => { HistoryData.picked-scan(item.scan); }
                }
            }
        }
    }

    if !HistoryData.empty: card := Rectangle {
        x: 168px + Tokens.gap;
        y: 13px;
        width: parent.width - self.x;
        height: head-h + 1px + ceil(HistoryData.seats.length / 2) * row-h + 8px;
        background: p.surface;
        border-radius: Tokens.card-radius;
        border-width: 1px;
        border-color: p.border;
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: head-h;
            border-top-left-radius: Tokens.card-radius - 1px;
            border-top-right-radius: Tokens.card-radius - 1px;
            background: p.surface-alt;
            Text {
                x: 16px;
                text: "模仿者狂欢（12人狂欢）";
                color: p.text;
                font-size: Tokens.body;
                vertical-alignment: center;
            }
            more := IconButton {
                x: parent.width - 16px - self.width;
                y: (parent.height - self.height) / 2;
                icon: "more";
                p: p;
                clicked => { menu-open = !menu-open; }
            }
        }
        Rectangle { x: 1px; y: head-h + 1px; width: parent.width - 2px; height: 1px; background: p.border; }
        for seat[index] in HistoryData.seats: SeatTile {
            x: 1px + mod(index, 2) * (parent.width - 2px) / 2;
            y: head-h + 2px + floor(index / 2) * row-h + 3px;
            width: (parent.width - 2px) / 2;
            height: row-h;
            seat: seat;
            p: p;
            clicked => { HistoryData.seat-clicked(index); }
        }
    }

    // 更多: 删除 and 清空记录 (red), under the button.
    if menu-open: TouchArea { clicked => { menu-open = false; } }
    if menu-open: Rectangle {
        x: root.width - 16px - 120px;
        y: 13px + head-h;
        width: 120px;
        height: 82px;
        background: p.surface;
        border-radius: Tokens.radius;
        border-width: 1px;
        border-color: p.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000030;
        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            for entry[i] in [{label: "删除", danger: false}, {label: "清空记录", danger: true}]: Rectangle {
                height: 34px;
                border-radius: Tokens.radius;
                background: pick.has-hover ? p.hover : transparent;
                Text {
                    x: 12px;
                    text: entry.label;
                    color: entry.danger ? p.danger : p.text;
                    font-size: Tokens.body;
                    vertical-alignment: center;
                }
                pick := TouchArea {
                    clicked => {
                        menu-open = false;
                        if i == 0 { HistoryData.delete-record(); } else { HistoryData.clear-records(); }
                    }
                }
            }
        }
    }
}

// HistoryPage in a window of its own, for the headless pictures.
export component HistoryWindow inherits Window {
    in property <bool> dark;
    in property <Palette> p;
    preferred-width: 900px;
    preferred-height: 560px;
    background: p.bg;
    default-font-family: "Noto Sans CJK SC";
    HistoryPage { x: 24px; y: 60px; width: parent.width - 48px; height: parent.height - 84px; dark: dark; p: p; }
}
