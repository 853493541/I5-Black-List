// 添加组合 / 编辑组合 (ui_guests.ComboDialog): on the left 已添加的嘉宾, every 嘉宾 in a box (those in it ticked; the
// box takes the height the 场景 beside it leave and its 嘉宾 scroll in it), the scene preview at the column's foot;
// on the right the 场景 that greet them (ScenePane).

import { Palette, Light, Dark, Tones, GuestTones, GuestSceneItem, ComboPersonItem, ScenePane, ScenePreview, DialogCard,
    DialogFooter, DialogButton, FieldLabel, TickBox, ThinBar } from "parts.slint";

export component ComboDialog inherits Window {
    in property <bool> dark;
    // ui_kit.Modal: frameless, laid over the main window\'s client area by the app (ui_dialogs::place).
    no-frame: true;
    // 编辑组合: its title, 保存 and 删除; else 添加组合 and 添加.
    in property <bool> editing;
    in property <[ComboPersonItem]> people;
    in property <string> people-error;
    in property <[GuestSceneItem]> scenes;
    in property <string> selected;
    in property <bool> playing;
    in property <image> frame;
    in property <int> rows: 11;
    callback person-toggled(int);
    callback play-toggled();
    callback picked(string);
    callback ticked(string);
    callback replay();
    callback save();
    callback remove();
    callback dismiss();
    out property <length> buttons-bottom: card.y + card.height;
    // The size it lays itself out at, for the renderer and the fit check.
    out property <length> natural-width: self.preferred-width;
    out property <length> natural-height: self.preferred-height;
    property <Palette> p: dark ? Dark.palette : Light.palette;
    property <GuestTones> t: dark ? Tones.dark : Tones.light;
    title: editing ? "编辑组合" : "添加组合";
    background: #b9b9b9;
    default-font-family: "Microsoft YaHei";
    VerticalLayout {
        padding: 22px;
        card := DialogCard {
            title: root.title;
            p: p;
            close => { root.dismiss(); }
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 24px;
                spacing: 24px;
                VerticalLayout {
                    width: 424px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;
                        FieldLabel { text: "已添加的嘉宾"; p: p; }
                        Rectangle {
                            vertical-stretch: 1;
                            // MIN_ROWS (3) rows at the least, in its 4 px padding.
                            min-height: 3 * 32px + 8px;
                            background: p.surface;
                            border-width: 1px;
                            border-color: p.border;
                            border-radius: 8px;
                            HorizontalLayout {
                                padding: 4px;
                                box := Flickable {
                                    content-height: people.length * 32px;
                                    for person[index] in people: TickBox {
                                        y: index * 32px;
                                        width: box.width;
                                        label: person.name;
                                        on: person.ticked;
                                        struck: person.gone;
                                        p: p;
                                        t: t;
                                        toggled => { root.person-toggled(index); }
                                    }
                                }
                                ThinBar { view: box.height; whole: box.content-height; at: box.content-y; p: p; }
                            }
                        }
                        if people-error != "": Text { text: people-error; font-size: 12px; color: p.red; }
                    }
                    ScenePreview { width: 424px; frame: frame; p: p; play: true; replay => { root.replay(); } }
                }
                ScenePane {
                    scenes: scenes;
                    selected: selected;
                    playing: playing;
                    rows: rows;
                    p: p;
                    t: t;
                    play-toggled => { root.play-toggled(); }
                    picked(key) => { root.picked(key); }
                    ticked(key) => { root.ticked(key); }
                }
            }
            DialogFooter {
                p: p;
                if editing: DialogButton { label: "删除"; kind: "danger"; p: p; t: t; clicked => { root.remove(); } }
                Rectangle { }
                DialogButton { label: editing ? "保存" : "添加"; kind: "primary"; p: p; t: t; clicked => { root.save(); } }
            }
        }
    }
}
