// 添加嘉宾 / 编辑嘉宾 (ui_likes.LikeDialog): 名字 and 昵称 side by side, 原因 under them and the scene preview under
// that on the left; on the right the 场景 that greet them (ScenePane). 编辑嘉宾 has 删除 at the foot's left.

import { Palette, Light, Dark, Tones, GuestTones, GuestSceneItem, ScenePane, ScenePreview, DialogCard, DialogFooter,
    DialogButton, FieldLabel, Field } from "parts.slint";

export component GuestDialog inherits Window {
    in property <bool> dark;
    // ui_kit.Modal: frameless, laid over the main window\'s client area by the app (ui_dialogs::place).
    no-frame: true;
    // 编辑嘉宾: its title, 保存 and 删除; else 添加嘉宾 and 添加.
    in property <bool> editing;
    in-out property <string> name;
    in-out property <string> nickname;
    in-out property <string> reason;
    in property <string> name-error;
    in property <[GuestSceneItem]> scenes;
    in property <string> selected;
    in property <bool> playing;
    in property <image> frame;
    // The scene rows shown before the list scrolls (ScenePane.ROWS).
    in property <int> rows: 11;
    callback play-toggled();
    callback picked(string);
    callback ticked(string);
    callback replay();
    callback save();
    callback remove();
    callback dismiss();
    // Where the card's foot ends, for the fit check: its buttons must be in view.
    out property <length> buttons-bottom: card.y + card.height;
    // The size it lays itself out at, for the renderer and the fit check.
    out property <length> natural-width: self.preferred-width;
    out property <length> natural-height: self.preferred-height;
    property <Palette> p: dark ? Dark.palette : Light.palette;
    property <GuestTones> t: dark ? Tones.dark : Tones.light;
    title: editing ? "编辑嘉宾" : "添加嘉宾";
    background: #b9b9b9;
    default-font-family: "Microsoft YaHei";
    VerticalLayout {
        padding: 22px;
        card := DialogCard {
            title: root.title;
            p: p;
            close => { root.dismiss(); }
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 24px;
                spacing: 24px;
                VerticalLayout {
                    width: 448px;
                    spacing: 12px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 3;
                            spacing: 6px;
                            FieldLabel { text: "名字"; p: p; }
                            Field { height: 34px; text <=> root.name; p: p; t: t; }
                            if name-error != "": Text {
                                text: name-error;
                                font-size: 12px;
                                color: p.red;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 6px;
                            alignment: start;
                            FieldLabel { text: "昵称"; p: p; }
                            Field { height: 34px; text <=> root.nickname; placeholder: "遇到时显示的名字"; p: p; t: t; }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "原因"; p: p; }
                        // REASON_LINES (3) lines of the body font and the box's own padding.
                        Field { height: 3 * 21px + 18px; multiline: true; text <=> root.reason; p: p; t: t; }
                    }
                    ScenePreview { width: 448px; frame: frame; p: p; play: true; replay => { root.replay(); } }
                }
                ScenePane {
                    scenes: scenes;
                    selected: selected;
                    playing: playing;
                    rows: rows;
                    p: p;
                    t: t;
                    play-toggled => { root.play-toggled(); }
                    picked(key) => { root.picked(key); }
                    ticked(key) => { root.ticked(key); }
                }
            }
            DialogFooter {
                p: p;
                if editing: DialogButton { label: "删除"; kind: "danger"; p: p; t: t; clicked => { root.remove(); } }
                Rectangle { }
                DialogButton { label: editing ? "保存" : "添加"; kind: "primary"; p: p; t: t; clicked => { root.save(); } }
            }
        }
    }
}
