// The pieces 添加嘉宾 / 编辑嘉宾, 添加组合 / 编辑组合 and 场景管理 share: the dialog card (ui_kit.Modal), the scene
// preview (ui_love_pick.ScenePreview), a scene's row (SceneChoice), the boxes (paint_box, TickBox) and ScenePane.

import { Palette, Light, Dark } from "../theme.slint";

// stub: ui-kit. The two colours of ui_theme.py these dialogs need that theme.slint's Palette lacks yet.
export struct GuestTones { field-line: color, on-accent: color, danger-hover: color }
export global Tones {
    out property <GuestTones> light: { field-line: #8b93a1, on-accent: #f4f8ff, danger-hover: #fbe9e7 };
    out property <GuestTones> dark: { field-line: #6e7685, on-accent: #0e1116, danger-hover: #3a2325 };
}

// One scene in a list, as the Rust side gives it (src/guestedit/mod.rs, SceneRow).
export struct GuestSceneItem { key: string, name: string, dot: color, ticked: bool, own: bool }

// One 嘉宾 a 组合 picks from: the name as the list shows it, ticked, struck out once taken off the list.
export struct ComboPersonItem { name: string, ticked: bool, gone: bool }

// The ✓ of line_pixmap("check"), on a 24 x 24 grid.
component Check inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke-width: 2px;
    commands: "M5 12.5 L10 17 L19 7.5";
}

// paint_box: filled with a ✓ when ticked, an empty square when not.
export component TickMark inherits Rectangle {
    in property <bool> on;
    in property <Palette> p;
    in property <GuestTones> t;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: on ? p.accent : p.surface;
    border-width: on ? 0 : 1.2px;
    border-color: t.field-line;
    if on: Check { x: 2px; y: 2px; width: 12px; height: 12px; stroke: t.on-accent; }
}

// TickBox: a box and its words, the whole row taking the click (播放场景, each 嘉宾 a 组合 picks from).
export component TickBox inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> struck;
    in property <Palette> p;
    in property <GuestTones> t;
    callback toggled();
    height: 32px;
    preferred-width: 6px + 16px + 8px + words.preferred-width + 6px;
    min-width: self.preferred-width;
    border-radius: 6px;
    background: touch.has-hover ? p.hover : transparent;
    TickMark { x: 6px; on: on; p: p; t: t; }
    words := Text {
        x: 30px;
        y: (parent.height - self.height) / 2;
        text: label;
        font-size: 12px;
        color: struck ? p.muted : p.text;
    }
    if struck: Rectangle {
        x: words.x - 1px;
        y: parent.height / 2;
        width: words.width + 2px;
        height: 1.5px;
        background: p.text;
    }
    touch := TouchArea { clicked => { toggled(); } }
}

// SceneChoice: the dot in the scene's colour and its name, highlighted in a ringed band; at its end ScenePane's
// box (mark "box") or 场景管理's spot (mark "spot": ✓ for the hotkey's), a ♪ before it for the player's own song.
export component SceneRow inherits Rectangle {
    in property <GuestSceneItem> item;
    in property <bool> selected;
    in property <string> mark: "box";
    in property <Palette> p;
    in property <GuestTones> t;
    callback picked();
    callback ticked();
    height: 34px;
    band := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 8px;
        background: selected ? p.selected : touch.has-hover ? p.hover : transparent;
        border-width: selected ? 1.5px : 0;
        border-color: p.accent-line;
    }
    Rectangle { x: 16px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; border-radius: 6px; background: item.dot; }
    touch := TouchArea { clicked => { picked(); } }
    Text {
        x: 40px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 40px - (mark == "box" ? 44px : 36px) - (item.own ? 20px : 0);
        text: item.name;
        font-size: 14px;
        font-weight: selected ? 600 : 400;
        overflow: elide;
        color: p.text;
    }
    if item.own: Text {
        x: parent.width - 51px;
        y: (parent.height - self.height) / 2;
        text: "♪";
        font-size: 16px;
        color: p.muted;
    }
    if mark == "box": TickMark {
        x: parent.width - 32px;
        on: item.ticked;
        p: p;
        t: t;
        TouchArea { width: 28px; height: 28px; clicked => { ticked(); } }
    }
    if mark == "spot": Rectangle {
        x: parent.width - 33px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: item.ticked ? p.accent : transparent;
        border-width: item.ticked ? 0 : 1.4px;
        border-color: spot.has-hover ? p.accent-line : t.field-line;
        if item.ticked: Check { x: 3px; y: 3px; width: 12px; height: 12px; stroke: t.on-accent; }
        spot := TouchArea { clicked => { ticked(); } }
    }
}

// ScenePreview: the scene over the sample lobby in a rounded frame, still (the poster) until a frame is fed.
// stub: stage. `frame` is the poster image the Rust side gives (src/guestedit/poster.rs); the stage package will
// later set it to live frames. With `play`, a ▶ in its corner asks for the scene from its start.
export component ScenePreview inherits Rectangle {
    in property <image> frame;
    in property <bool> play;
    in property <Palette> p;
    callback replay();
    // The sample lobby's shape, love_scenes.DESIGN (1635 x 848).
    height: self.width * 848 / 1635;
    border-radius: 10px;
    clip: true;
    background: #10141c;
    Image { width: 100%; height: 100%; source: frame; image-fit: cover; }
    Rectangle { border-radius: 10px; border-width: 1px; border-color: p.border; }
    if play: Rectangle {
        x: parent.width - 44px;
        y: parent.height - 44px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: go.has-hover ? #000000a0 : #00000070;
        Path { x: 11px; y: 9px; width: 12px; height: 14px; fill: #ffffff; commands: "M0 0 L12 7 L0 14 Z"; }
        go := TouchArea { clicked => { replay(); } }
    }
}

// The scroll bar _CardScroll shows beside a list once it has more rows than it shows (_SCROLL_BAR wide).
export component ThinBar inherits Rectangle {
    in property <length> view;
    in property <length> whole;
    in property <length> at;
    in property <Palette> p;
    width: 12px;
    if whole > view: Rectangle {
        x: 3px;
        width: 6px;
        height: max(24px, parent.height * view / whole);
        y: (parent.height - self.height) * (-at) / max(1px, whole - view);
        border-radius: 3px;
        background: p.selected;
    }
}

// ScenePane: 播放场景 over 随机 and every scene, one per row; past `rows` rows the list scrolls in its column.
export component ScenePane inherits VerticalLayout {
    in property <[GuestSceneItem]> scenes;
    in property <string> selected;
    in property <bool> playing;
    in property <int> rows: 11;
    in property <Palette> p;
    in property <GuestTones> t;
    callback play-toggled();
    callback picked(string);
    callback ticked(string);
    spacing: 6px;
    alignment: start;
    HorizontalLayout {
        alignment: start;
        TickBox { label: "播放场景"; on: playing; p: p; t: t; toggled => { play-toggled(); } }
    }
    HorizontalLayout {
        list := Flickable {
            width: 200px;
            height: min(scenes.length, rows) * 36px - 2px;
            content-height: scenes.length * 36px - 2px;
            for item[index] in scenes: SceneRow {
                y: index * 36px;
                width: 200px;
                item: item;
                selected: item.key == selected;
                p: p;
                t: t;
                picked => { root.picked(item.key); }
                ticked => { root.ticked(item.key); }
            }
        }
        ThinBar { view: list.height; whole: list.content-height; at: list.content-y; p: p; }
    }
}

// The outlined, primary or danger button of the dialogs' foot.
export component DialogButton inherits Rectangle {
    in property <string> label;
    in property <string> kind: "plain";
    in property <Palette> p;
    in property <GuestTones> t;
    callback clicked();
    height: 34px;
    width: max(58px, words.preferred-width + 32px);
    border-radius: 6px;
    border-width: 1px;
    border-color: kind == "primary" ? p.accent : kind == "danger" ? p.danger : touch.has-hover ? p.accent-line : p.border;
    background: kind == "primary" ? p.accent : touch.has-hover ? (kind == "danger" ? t.danger-hover : p.hover) : p.surface;
    words := Text {
        text: label;
        font-size: 14px;
        color: kind == "primary" ? t.on-accent : kind == "danger" ? p.danger : p.text;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A label over its control, as ui_dialogs._field lays them.
export component FieldLabel inherits Text {
    in property <Palette> p;
    font-size: 14px;
    color: p.text;
}

// QLineEdit / QPlainTextEdit as the dialogs style them: a 1 px line, 6 px corners, 10 px in.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> multiline;
    in property <Palette> p;
    in property <GuestTones> t;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? p.accent : touch.has-hover ? p.accent-line : t.field-line;
    background: p.surface;
    touch := TouchArea { }
    input := TextInput {
        x: 13px;
        y: multiline ? 10px : (parent.height - self.height) / 2;
        width: parent.width - 26px;
        height: multiline ? parent.height - 20px : self.preferred-height;
        text <=> root.text;
        font-size: 14px;
        color: p.text;
        single-line: !multiline;
        wrap: multiline ? word-wrap : no-wrap;
    }
    if text == "" && !input.has-focus: Text {
        x: 13px;
        y: multiline ? 10px : (parent.height - self.height) / 2;
        text: placeholder;
        font-size: 14px;
        color: p.muted;
    }
}

// stub: ui-kit. ui_kit.Modal's card: the title and a × in its first row, the content, and the band of buttons at
// its foot (none on 场景管理).
export component DialogCard inherits Rectangle {
    in property <string> title;
    in property <Palette> p;
    callback close();
    background: p.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: p.border;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000040;
    VerticalLayout {
        HorizontalLayout {
            padding-top: 18px;
            padding-left: 24px;
            padding-right: 12px;
            padding-bottom: 16px;
            height: 18px + 32px + 16px;
            Text { text: title; font-size: 18px; font-weight: 700; color: p.text; vertical-alignment: center; }
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: shut.has-hover ? p.hover : transparent;
                Path {
                    width: 14px;
                    height: 14px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    stroke: p.muted;
                    stroke-width: 1.6px;
                    commands: "M5 5 L19 19 M19 5 L5 19";
                }
                shut := TouchArea { clicked => { close(); } }
            }
        }
        @children
    }
}

// The band along the card's foot: 删除 apart on the left, the main action on the right.
export component DialogFooter inherits Rectangle {
    in property <Palette> p;
    height: 59px;
    background: p.bg;
    border-radius: 11px;
    Rectangle { y: 0; height: 12px; background: p.bg; }
    Rectangle { y: 0; height: 1px; background: p.border; }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 12px;
        padding-bottom: 12px;
        @children
    }
}

export { Palette, Light, Dark }
