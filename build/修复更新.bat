@echo off
rem Fixes a stuck update of the app: ends every copy running from a BlackListDetect folder,
rem stuck ones too, then opens the app again so the waiting update goes in. For friends on
rem v0.8.1 or older; v0.8.2 and later end a stuck copy by themselves. Made by build/make_fix_bat.py.
powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$m = if ($env:FIX_MATCH) { $env:FIX_MATCH } else { '*\BlackListDetect\*' }; $ps = Get-Process | Where-Object { $_.Path -and ($_.Path -like $m) }; Add-Type -AssemblyName System.Windows.Forms; $t = ''+[char]20462+[char]22797+[char]26356+[char]26032; if (-not $ps) { if (-not $env:FIX_QUIET) { [System.Windows.Forms.MessageBox]::Show(''+[char]27809+[char]26377+[char]25214+[char]21040+[char]27491+[char]22312+[char]36816+[char]34892+[char]30340+[char]27169+[char]20223+[char]32773+[char]23567+[char]24037+[char]20855+[char]12290+[char]35831+[char]30452+[char]25509+[char]25171+[char]24320+[char]23427+[char]12290, $t) | Out-Null }; exit }; $roots = @($ps | ForEach-Object { $d = Split-Path $_.Path; if ((Split-Path $d -Leaf) -eq 'runtime') { Split-Path $d } else { $d } } | Sort-Object -Unique); $ps | Stop-Process -Force -ErrorAction SilentlyContinue; Get-Process WerFault -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2; if (-not $env:FIX_QUIET) { [System.Windows.Forms.MessageBox]::Show(''+[char]24050+[char]20851+[char]38381+[char]27169+[char]20223+[char]32773+[char]23567+[char]24037+[char]20855+[char]65292+[char]27491+[char]22312+[char]37325+[char]26032+[char]25171+[char]24320+[char]12290+[char]26356+[char]26032+[char]20250+[char]33258+[char]21160+[char]35013+[char]22909+[char]12290, $t) | Out-Null }; foreach ($r in $roots) { $l = Get-ChildItem -LiteralPath $r -Filter *.exe | Select-Object -First 1; if ($l) { Start-Process -FilePath $l.FullName -WorkingDirectory $r } }"
